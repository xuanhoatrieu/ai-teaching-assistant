generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  passwordHash         String             @map("password_hash")
  role                 UserRole           @default(USER)
  apiKeyEnc            String?            @map("api_key_enc")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  fullName             String?            @map("full_name")
  organization         String?            @map("organization")
  phone                String?            @map("phone")
  status               UserStatus         @default(APPROVED)
  resetPasswordExpires DateTime?          @map("reset_password_expires")
  resetPasswordToken   String?            @map("reset_password_token")
  apiKeys              ApiKey[]
  modelConfigs         ModelConfig[]
  pptxAudioSessions    PptxAudioSession[]
  templates            PPTXTemplate[]
  subjects             Subject[]
  ttsConfigs           UserTTSConfig[]
  videoGenerations     VideoGeneration[]

  @@map("users")
}

model Subject {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  name              String
  description       String?
  institutionType   String?           @map("institution_type")
  expertiseArea     String?           @map("expertise_area")
  courseName        String?           @map("course_name")
  targetAudience    String?           @map("target_audience")
  majorName         String?           @map("major_name")
  additionalContext String?           @map("additional_context")
  language          String            @default("vi")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  lessons           Lesson[]
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  syllabus          Syllabus?
  videoGenerations  VideoGeneration[]

  @@map("subjects")
}

model Lesson {
  id                   String                @id @default(uuid())
  subjectId            String                @map("subject_id")
  templateId           String?               @map("template_id")
  title                String
  outlineRaw           String?               @map("outline_raw")
  status               LessonStatus          @default(DRAFT)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  detailedOutline      String?               @map("detailed_outline")
  slideScript          String?               @map("slide_script")
  currentStep          Int                   @default(1) @map("current_step")
  generatedContents    GeneratedContent[]
  interactiveQuestions InteractiveQuestion[]
  subject              Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  template             PPTXTemplate?         @relation(fields: [templateId], references: [id])
  questionBank         QuestionBank?
  reviewQuestions      ReviewQuestion[]
  slideAudios          SlideAudio[]
  slides               Slide[]
  syllabusLesson       SyllabusLesson?
  videoGenerations     VideoGeneration[]

  @@map("lessons")
}

model Prompt {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  content   String
  variables String[]
  version   Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("prompts")
}

model TTSProvider {
  id             String          @id @default(uuid())
  name           String          @unique
  type           TTSProviderType
  endpoint       String?
  requiredFields String[]        @map("required_fields")
  isSystem       Boolean         @default(false) @map("is_system")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  userConfigs    UserTTSConfig[]

  @@map("tts_providers")
}

model UserTTSConfig {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  providerId     String      @map("provider_id")
  credentialsEnc String      @map("credentials_enc")
  isDefault      Boolean     @default(false) @map("is_default")
  createdAt      DateTime    @default(now()) @map("created_at")
  provider       TTSProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@map("user_tts_configs")
}

model ApiKey {
  id           String     @id @default(uuid())
  name         String
  keyEncrypted String     @map("key_encrypted")
  service      APIService
  isSystem     Boolean    @default(false) @map("is_system")
  userId       String?    @map("user_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model GeneratedContent {
  id          String        @id @default(uuid())
  lessonId    String        @map("lesson_id")
  type        ContentType
  contentJson String?       @map("content_json")
  fileUrl     String?       @map("file_url")
  status      ContentStatus @default(PENDING)
  errorMsg    String?       @map("error_msg")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  lesson      Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("generated_contents")
}

model PPTXTemplate {
  id           String   @id @default(uuid())
  name         String
  description  String?
  titleBgUrl   String   @map("title_bg_url")
  contentBgUrl String   @map("content_bg_url")
  thumbnailUrl String?  @map("thumbnail_url")
  fileUrl      String?  @map("file_url")
  stylingJson  String?  @map("styling_json")
  isSystem     Boolean  @default(false) @map("is_system")
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")
  userId       String?  @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lessons      Lesson[]
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pptx_templates")
}

model QuestionBank {
  id            String   @id @default(uuid())
  lessonId      String   @unique @map("lesson_id")
  questionsJson String   @map("questions_json")
  levelCounts   String?  @map("level_counts")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("question_banks")
}

model ModelConfig {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  taskType  TaskType @map("task_type")
  provider  String
  modelName String   @map("model_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskType])
  @@map("model_configs")
}

model SlideAudio {
  id            String   @id @default(uuid())
  lessonId      String   @map("lesson_id")
  slideIndex    Int      @map("slide_index")
  slideTitle    String?  @map("slide_title")
  speakerNote   String
  audioFileName String?  @map("audio_file_name")
  audioUrl      String?  @map("audio_url")
  audioDuration Float?   @map("audio_duration")
  voiceId       String?  @map("voice_id")
  status        String   @default("pending")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, slideIndex])
  @@map("slide_audios")
}

model Slide {
  id                   String   @id @default(uuid())
  lessonId             String   @map("lesson_id")
  slideIndex           Int      @map("slide_index")
  slideType            String   @default("content")
  title                String
  content              String?
  optimizedContentJson String?  @map("optimized_content_json")
  visualIdea           String?  @map("visual_idea")
  speakerNote          String?  @map("speaker_note")
  imagePrompt          String?  @map("image_prompt")
  imageUrl             String?  @map("image_url")
  audioUrl             String?  @map("audio_url")
  audioDuration        Float?   @map("audio_duration")
  status               String   @default("draft")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  lesson               Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, slideIndex])
  @@map("slides")
}

model InteractiveQuestion {
  id                String   @id @default(uuid())
  lessonId          String   @map("lesson_id")
  questionOrder     Int      @default(0) @map("question_order")
  questionType      String   @default("MC") @map("question_type")
  questionText      String   @map("question_text")
  imageUrl          String?  @map("image_url")
  videoUrl          String?  @map("video_url")
  audioUrl          String?  @map("audio_url")
  answer1           String?  @map("answer_1")
  answer2           String?  @map("answer_2")
  answer3           String?  @map("answer_3")
  answer4           String?  @map("answer_4")
  answer5           String?  @map("answer_5")
  answer6           String?  @map("answer_6")
  answer7           String?  @map("answer_7")
  answer8           String?  @map("answer_8")
  answer9           String?  @map("answer_9")
  answer10          String?  @map("answer_10")
  correctFeedback   String?  @map("correct_feedback")
  incorrectFeedback String?  @map("incorrect_feedback")
  points            Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("interactive_questions")
}

model ReviewQuestion {
  id            String   @id @default(uuid())
  lessonId      String   @map("lesson_id")
  questionId    String   @map("question_id")
  questionOrder Int      @default(0) @map("question_order")
  level         Int      @default(1)
  question      String
  correctAnswer String   @map("correct_answer")
  optionB       String   @map("option_b")
  optionC       String   @map("option_c")
  optionD       String   @map("option_d")
  explanation   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, questionId])
  @@map("review_questions")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model PptxAudioSession {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  fileName      String   @map("file_name")
  filePath      String   @map("file_path")
  slidesJson    String?  @map("slides_json")
  contentJson   String?  @map("content_json")
  questionsJson String?  @map("questions_json")
  language      String   @default("vi")
  status        String   @default("uploaded")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pptx_audio_sessions")
}

model VideoGeneration {
  id             String       @id @default(uuid())
  subjectId      String       @map("subject_id")
  lessonId       String?      @map("lesson_id")
  userId         String       @map("user_id")
  title          String       @default("Video mới")
  inputType      String       @default("manual") @map("input_type")
  inputText      String?      @map("input_text")
  inputFilesJson Json?        @map("input_files_json")
  format         String       @default("horizontal")
  resolution     String       @default("1080p")
  style          String       @default("auto")
  narrationLang  String       @default("vi") @map("narration_lang")
  subtitleLang   String       @default("vi") @map("subtitle_lang")
  narrationSpeed Float        @default(1.0) @map("narration_speed")
  videoScript    Json?        @map("video_script")
  editedScript   Json?        @map("edited_script")
  scriptStatus   String       @default("none") @map("script_status")
  wizardStep     Int          @default(1) @map("wizard_step")
  status         String       @default("draft")
  progress       Int          @default(0)
  renderStep     String?      @map("render_step")
  totalScenes    Int          @default(0) @map("total_scenes")
  doneScenes     Int          @default(0) @map("done_scenes")
  errorMessage   String?      @map("error_message")
  videoUrl       String?      @map("video_url")
  subtitleUrl    String?      @map("subtitle_url")
  thumbnailUrl   String?      @map("thumbnail_url")
  duration       Float?
  fileSize       Int?         @map("file_size")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  lesson         Lesson?      @relation(fields: [lessonId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes         VideoScene[]

  @@index([subjectId])
  @@index([lessonId])
  @@index([userId])
  @@index([status])
  @@map("video_generations")
}

model VideoScene {
  id            String          @id @default(uuid())
  videoGenId    String          @map("video_gen_id")
  sceneIndex    Int             @map("scene_index")
  title         String
  approach      String
  narrationText String          @map("narration_text")
  subtitleText  String?         @map("subtitle_text")
  visualDesc    String?         @map("visual_desc")
  imagePrompt   String?         @map("image_prompt")
  imageUrl      String?         @map("image_url")
  manimCode     String?         @map("manim_code")
  codeLines     Json?           @map("code_lines")
  clipUrl       String?         @map("clip_url")
  audioUrl      String?         @map("audio_url")
  duration      Float?
  status        String          @default("pending")
  errorMessage  String?         @map("error_message")
  retryCount    Int             @default(0) @map("retry_count")
  createdAt     DateTime        @default(now()) @map("created_at")
  approved      Boolean         @default(false)
  videoGen      VideoGeneration @relation(fields: [videoGenId], references: [id], onDelete: Cascade)

  @@unique([videoGenId, sceneIndex])
  @@index([videoGenId])
  @@map("video_scenes")
}

model Syllabus {
  id         String              @id @default(uuid())
  subjectId  String              @unique @map("subject_id")
  status     String              @default("draft")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  subject    Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  blocks     SyllabusBlock[]
  lessons    SyllabusLesson[]
  references SyllabusReference[]

  @@map("syllabi")
}

model SyllabusBlock {
  id         String   @id @default(uuid())
  syllabusId String   @map("syllabus_id")
  blockType  String   @map("block_type")
  title      String
  content    String   @default("")
  metadata   Json?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)

  @@map("syllabus_blocks")
}

model SyllabusReference {
  id              String   @id @default(uuid())
  syllabusId      String   @map("syllabus_id")
  fileName        String   @map("file_name")
  fileUrl         String   @map("file_url")
  fileSize        Int?     @map("file_size")
  markdownContent String?  @map("markdown_content")
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")
  syllabus        Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  chunks          SyllabusReferenceChunk[]

  @@map("syllabus_references")
}

model SyllabusReferenceChunk {
  id             String            @id @default(uuid())
  referenceId    String            @map("reference_id")
  chunkIndex     Int               @map("chunk_index")
  content        String
  embedding      Float[]
  embeddingModel String            @map("embedding_model")
  createdAt      DateTime          @default(now()) @map("created_at")
  reference      SyllabusReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@index([referenceId])
  @@map("syllabus_reference_chunks")
}

model SyllabusLesson {
  id              String   @id @default(uuid())
  syllabusId      String   @map("syllabus_id")
  sortOrder       Int      @map("sort_order")
  title           String
  outline         String
  textbookContent String?  @map("textbook_content")
  textbookStatus  String   @default("none") @map("textbook_status")
  lessonId        String?  @unique @map("lesson_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  textbookImages  Json?    @map("textbook_images")
  textbookPhase   String?  @map("textbook_phase")
  textbookPlan    String?  @map("textbook_plan")
  lesson          Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  syllabus        Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)

  @@map("syllabus_lessons")
}

model GenerationJob {
  id        String   @id @default(uuid())
  type      String
  lessonId  String   @map("lesson_id")
  userId    String   @map("user_id")
  status    String   @default("pending")
  progress  Int      @default(0)
  total     Int      @default(0)
  message   String?
  result    Json?
  error     String?
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lessonId])
  @@index([status])
  @@map("generation_jobs")
}

model UsefulLink {
  id          String   @id @default(uuid())
  title       String
  url         String
  icon        String   @default("🔗")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("useful_links")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LessonStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
}

enum ContentType {
  PPTX
  HANDOUT
  QUIZ_EXCEL
  QUIZ_WORD
}

enum TTSProviderType {
  GEMINI
  GOOGLE_CLOUD
  VBEE
  CUSTOM
  VITTS
}

enum APIService {
  GEMINI
  GOOGLE_CLOUD_TTS
  IMAGEN
  VBEE
  VITTS
  CLIPROXY
  OPENAI
}

enum ContentStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum TaskType {
  OUTLINE
  SLIDES
  SPEAKER_NOTES
  QUESTIONS
  IMAGE
  TTS
  EMBEDDING
}
